{
  "name": "silo-browser",
  "productName": "Silo Browser",
  "version": "0.1.0",
  "description": "Perfiles de Chrome aislados, cada uno con su propia cuenta y sesión.",
  "main": "./out/main/index.js",
  "author": {
    "name": "IdealDevs",
    "email": "samuel@amauta.tech"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "dist:mac": "npm run build && electron-builder --mac --publish never -c.mac.identity=-",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never -c.mac.identity=-",
    "dist:mac:signed": "npm run build && electron-builder --mac --publish never",
    "test:chrome": "SILO_REAL_CHROME=1 vitest run tests/real-chrome.test.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "zod": "^4.3.5",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@fontsource-variable/manrope": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.0"
  },
  "homepage": "https://github.com/iparadise71/silo-browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/iparadise71/silo-browser.git"
  },
  "bugs": {
    "url": "https://github.com/iparadise71/silo-browser/issues"
  }
}
